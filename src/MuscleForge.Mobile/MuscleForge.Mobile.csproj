<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MuscleForge.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>MuscleForge</ApplicationTitle>
    <ApplicationId>local.muscleforge.app</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- CI APKs must work with adb install without a fast-deployment session. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MuscleForge.Mobile.Core/MuscleForge.Mobile.Core.csproj" />
    <ProjectReference Include="../MuscleForge.Client/MuscleForge.Client.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#0F1512" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0F1512" BaseSize="128,128" />
    <MauiImage Include="Resources/Images/*.svg" />
    <MauiFont Include="Resources/Fonts/*.ttf" />
    <MauiAsset Include="Resources/Fonts/Manrope-OFL.txt" LogicalName="Manrope-OFL.txt" />
  </ItemGroup>
</Project>
