<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MuscleForge.Mobile.App">
  <Application.Resources>
    <ResourceDictionary>
      <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#111827}" />
      </Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F8FAFC}" />
        <Setter Property="FontSize" Value="16" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="#1D4ED8" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F8FAFC}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
