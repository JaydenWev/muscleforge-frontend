                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "status",
                    "title",
                    "traceId",
                    "type"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 401"
          },
          "429": {
